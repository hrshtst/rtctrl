build*/
compile_commands.json
.cache/
.local/
/.envrc
.envrc.local
__pycache__/
.venv/
site/

# Hardware/sim telemetry lands at the repo root by default — raw data
# is archived privately (see docs/records/data-archive.md), never committed.
# (data/ holds the deliberately tracked evidence sidecars.)
/*.csv
/*.csv.*
/*.zvs
/dump*.txt

# Locally installed skills are personal tooling, not shared with the
# team: the payload (.agents/), the .claude/skills symlink, and the
# install lock all stay out of the shared history. Only the
# repo-authored skills are whitelisted below.
.agents/
/skills-lock.json
.claude/skills/*
!.claude/skills/preflight
!.claude/skills/archive-data
