# Repo-local environment (direnv). The mi-lib stack is installed into
# .local/ (gitignored) by tools/bootstrap_milib.sh; both the bootstrap
# and cmake/FindMiLib.cmake honor MILIB_PREFIX, so builds inside the
# repo resolve against this prefix without touching the global env.
export MILIB_PREFIX=$PWD/.local
PATH_add "$MILIB_PREFIX/bin"
path_add LD_LIBRARY_PATH "$MILIB_PREFIX/lib"

# Machine-local additions (never committed; anything private — e.g. the
# data-archive location — belongs here, per docs/DATA_ARCHIVE.md).
source_env_if_exists .envrc.local
